{
  "appId": "com.voxsynth.dd6",
  "appName": "VoxSynth DD-6",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "cleartext": false
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false,
    "backgroundColor": "#0c1118"
  },
  "plugins": {
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0c1118"
    },
    "KeepAwake": {
      "enabled": true
    }
  }
}
